#include <iostream>
using namespace std;

int main() {
    int N;
    long long F0 = 1, F1 = 1, F;

    cout << "Ingrese N: ";
    cin >> N;

    if (N == 0 || N == 1) {
        cout << "El numero Fibonacci es: 1";
    } 
    else {
        for (int i = 2; i <= N; i++) {
            F = F0 + F1;
            F0 = F1;
            F1 = F;
        }

        cout << "El numero Fibonacci es: " << F1;
    }

    return 0;
}
