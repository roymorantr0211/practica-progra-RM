#include <iostream>
#include <cmath>
using namespace std;

int main() {
    int N;
    double X, S = 0, factorial = 1;

    cout << "Ingrese X: ";
    cin >> X;

    cout << "Ingrese N: ";
    cin >> N;

    for (int i = 1; i <= N; i++) {
        factorial = factorial * i;

        if (i % 2 == 0)
            S = S - pow(X, i) / factorial;
        else
            S = S + pow(X, i) / factorial;
    }

    cout << "La suma es: " << S;

    return 0;
}
